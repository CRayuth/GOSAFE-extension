{
  "manifest_version": 3,
  "name": "GOSAFE adblock",
  "version": "1.26.23",
  "description": "GOSAFE adblock \u2014 tracker blocking, DNS defense, Force English, link preview, text selection (QCM + NVIDIA), video PiP, reader mode, Quiz Assist (Kahoot bank + NVIDIA), and security assistant.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "webNavigation",
    "webRequest",
    "privacy",
    "alarms",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/user-agent.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GOSAFE adblock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allowlist",
        "enabled": true,
        "path": "rules/allowlist.json"
      },
      {
        "id": "d3host",
        "enabled": true,
        "path": "rules/d3host.json"
      },
      {
        "id": "redirects",
        "enabled": true,
        "path": "rules/redirects.json"
      },
      {
        "id": "trackparams",
        "enabled": true,
        "path": "rules/trackparams.json"
      },
      {
        "id": "protections",
        "enabled": true,
        "path": "rules/protections.json"
      },
      {
        "id": "https_upgrade",
        "enabled": true,
        "path": "rules/https_upgrade.json"
      },
      {
        "id": "blocklist_1",
        "enabled": true,
        "path": "rules/blocklist_1.json"
      },
      {
        "id": "blocklist_2",
        "enabled": true,
        "path": "rules/blocklist_2.json"
      },
      {
        "id": "blocklist_3",
        "enabled": true,
        "path": "rules/blocklist_3.json"
      },
      {
        "id": "urlfilter_1",
        "enabled": true,
        "path": "rules/urlfilter_1.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "web-accessible-resources/redirects/*",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/mylogo-64.png",
        "icons/default_logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/page-tech-probe.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "clickguard-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "security-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "security-watch-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "security-assistant.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "force-english-page.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "link-preview-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "text-selection-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "reader-mode-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.kahoot.it/*",
        "*://kahoot.it/*"
      ],
      "js": [
        "quiz-assist-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "quiz-assist-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extras-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "loginwall-page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ua-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fingerprint-page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://medium.com/*",
        "*://*.medium.com/*"
      ],
      "js": [
        "medium.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://play.spotify.com/*"
      ],
      "js": [
        "spotify.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://play.spotify.com/*"
      ],
      "js": [
        "spotify-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
